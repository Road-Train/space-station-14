<windows:CharacterWindow
    xmlns="https://spacestation14.io"
    xmlns:windows="clr-namespace:Content.Client.UserInterface.Systems.Character.Windows"
    xmlns:ui="clr-namespace:Content.Client._Starlight.Character.Info.UI"
    xmlns:controls="clr-namespace:Content.Client._Starlight.UI.Systems.Characters.Controls"
    Title="{Loc 'character-info-title'}"
    MinWidth="400"
    MinHeight="545">
    <ScrollContainer>
        <TabContainer Name="CharacterInfoTabs" Access="Public">
            <controls:CharacterOverviewControl Name="CharacterInfo" Access="Public"/>
            <ui:CharacterICInfoControl Name="InfoIC" Access="Public"/>
            <ui:CharacterOOCInfoControl Name="InfoOOC" Access="Public"/>
        </TabContainer>
    </ScrollContainer>
</windows:CharacterWindow>
